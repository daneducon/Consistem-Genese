# ============================================================
# FRONTEND — Vercel / Local (Vite expõe só VITE_*)
# Copie para .env local. Na Vercel: Settings > Environment Variables
# ============================================================

# --- API ---
# Local: http://localhost:8000 (proxy Vite /api -> 8000 se vazio)
# Produção (https://consistem-genese.vercel.app): defina a URL da API quando subir o backend
# Ex: VITE_API_BASE_URL=https://genese-api-xxx.railway.app
VITE_API_BASE_URL=http://localhost:8000

# P0 Segurança: se backend AUTH_DISABLED=false, defina igual ao backend API_KEY
# VITE_API_KEY=seu-segredo-compartilhado-32chars

# --- GOOGLE OAUTH (Vercel) ---
# Onde obter: https://console.cloud.google.com > APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Tipo: Web application — Authorized redirect URIs deve conter o FRONTEND_URL abaixo
# 1) Local: http://localhost:5173/auth/callback
# 2) Produção: https://consistem-genese.vercel.app/auth/callback
VITE_GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# Opcional: restringe login ao Workspace Consistem
VITE_GOOGLE_WORKSPACE_DOMAIN=consistem.com.br
# URL pública do frontend (usada no redirect do OAuth e no OPENROUTER_SITE_URL do backend)
VITE_FRONTEND_URL=http://localhost:5173
# Em produção Vercel: https://consistem-genese.vercel.app

# --- VERCEL (auto) ---
# VERCEL_ENV=production (Vercel injeta) — usado no CSP/HSTS
