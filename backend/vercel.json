{
  "version": 2,
  "builds": [{ "src": "api/index.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "env": {
    "PYTHON_VERSION": "3.11",
    "USE_NOTEBOOKLM": "true",
    "NOTEBOOKLM_TIMEOUT_S": "9"
  },
  "functions": {
    "api/index.py": { "maxDuration": 25, "memory": 1024 }
  }
}
