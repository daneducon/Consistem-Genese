# ============================================================
# BACKEND — Railway / Cloud Run / Render (FastAPI)
# Copie para backend/.env local. NÃO comitar .env real.
# Na Vercel não vai — configure no provedor da API.
# ============================================================

# --- OBRIGATÓRIA: OpenRouter + Gemma ---
# Onde obter: https://openrouter.ai/keys > Create API Key
OPENROUTER_API_KEY=sk-or-v1-...
# Modelo: google/gemma-3-27b-it (27B) | :free | 12b | 4b
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Deve ser a URL pública da Vercel em produção (para ranking OpenRouter)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Consistem Sinapse GEM

# --- NOTEBOOKLM-PY MVP ---
USE_NOTEBOOKLM=true
# Auth local: notebooklm login -> ~/.config/notebooklm/storage_state.json

# --- BACKEND CONFIG ---
PORT=8000
# Produção: domínios exatos da Vercel — nunca * com AUTH habilitado
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Em produção: https://seu-app.vercel.app,https://seu-app-xxx.vercel.app
AUTH_DISABLED=true
API_KEY=
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
TEMPERATURE=0.2
ENV=development
# Em produção: ENV=production (ativa HSTS)

# ============================================================
# GOOGLE OAUTH — Vercel (Sprint 5)
# Onde obter: https://console.cloud.google.com
# 1) Crie projeto > APIs & Services > OAuth consent screen
#    - User Type: Internal (Workspace) se quiser restringir a @consistem.com.br
#    - Scopes: openid, email, profile
# 2) Credentials > Create Credentials > OAuth client ID > Web application
#    - Authorized JavaScript origins:
#      http://localhost:5173
#      https://seu-app.vercel.app
#    - Authorized redirect URIs:
#      http://localhost:5173/auth/callback
#      https://seu-app.vercel.app/auth/callback
#      http://localhost:8000/api/v1/auth/google/callback  (se callback for no backend)
#      https://sua-api.railway.app/api/v1/auth/google/callback
# ============================================================

# Client ID da Web application (mesmo valor do VITE_GOOGLE_OAUTH_CLIENT_ID do frontend)
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# Client Secret — NUNCA exponha no frontend, só no backend
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx
# URL de callback — deve bater com a configurada no Google Cloud
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Em produção: https://sua-api.railway.app/api/v1/auth/google/callback
# Se usar callback no frontend (implicit): https://seu-app.vercel.app/auth/callback

# Frontend público — usado para validar redirect e CORS
FRONTEND_URL=http://localhost:5173
# Em produção: https://seu-app.vercel.app

# Restringe login ao Workspace Consistem (opcional mas recomendado)
GOOGLE_WORKSPACE_DOMAIN=consistem.com.br
# Deixe vazio para permitir qualquer conta Google

# Segredo para assinar JWT/Session Cookie — gere com: openssl rand -hex 32
JWT_SECRET=troque-por-64-hex-aleatorio-openssl-rand-hex-32
SESSION_SECRET=troque-por-outro-64-hex-aleatorio
# Expiração do JWT (ex: 7d, 24h)
JWT_EXPIRES_IN=7d
