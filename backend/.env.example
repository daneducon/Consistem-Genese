# ============================================================
# SPRINT 1 & 2 — Keys (OpenRouter + Gemma)
# Copie para .env e preencha. NÃO comitar .env real.
# ============================================================

# --- OBRIGATÓRIA SPRINT 2: OpenRouter ---
# Onde obter: https://openrouter.ai/keys > Create API Key
# Billing: https://openrouter.ai/credits > Add Credits (Gemma 3 27B ~ $0.10/1M input)
# Docs: https://openrouter.ai/docs
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo Gemma via OpenRouter — você pediu "gemma4 31b"
# NOTA: Não existe Gemma 4 31B no catálogo (abr/2026). O equivalente é:
# - google/gemma-3-27b-it       (27B, multimodal, recomendado)
# - google/gemma-3-27b-it:free  (variante free com rate limit)
# - google/gemma-3-12b-it       (12B, mais barato)
# - google/gemma-3-4b-it        (4B, mais rápido)
# Se a OpenRouter lançar gemma-4, troque apenas esta linha:
OPENROUTER_MODEL=google/gemma-3-27b-it
# OPENROUTER_MODEL=google/gemma-3-27b-it:free
# OPENROUTER_MODEL=google/gemma-3-12b-it

# Opcional — recomendado pela OpenRouter para ranking/app
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Consistem Sinapse GEM

# --- NOTEBOOKLM-PY MVP ---
# Ative para tentar criar notebooks reais no NotebookLM
USE_NOTEBOOKLM=true
# Auth: escolha 1 dos 3 (veja README notebooklm-py):
# 1) notebooklm login  -> gera ~/.config/notebooklm/storage_state.json (recomendado)
# 2) notebooklm login --browser-cookies chrome
# 3) notebooklm login --master-token --account analista@consisten.com.br

# --- BACKEND CONFIG ---
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_DISABLED=true
MAX_UPLOAD_MB=20
LOG_LEVEL=info
TEMPERATURE=0.2

# --- FRONTEND (espelhado no frontend/.env.example) ---
# VITE_API_BASE_URL=http://localhost:8000

# --- LEGADO GOOGLE (não use com OpenRouter) ---
# Mantido apenas se quiser voltar ao Gemini direto no futuro:
# GEMINI_API_KEY=AIza...
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
# GCP_PROJECT_ID=consistem-sinapse-prod

# --- SPRINT 5 (login Workspace, não necessário agora) ---
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_WORKSPACE_DOMAIN=consistem.com.br
